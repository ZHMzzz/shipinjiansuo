-        model_output = self.model.get_image_features(images=images).float()
+        # PyTorch 2.8 / MPS on Apple M5 can abort in SigLIP's attention
+        # pooling for batches > 1 (MPSNDArray buffer-size assertion).
+        # Process each frame separately on MPS, preserving batch ordering.
+        if str(self.model.DEVICE).startswith("mps") and len(images) > 1:
+            model_output = torch.cat([
+                self.model.get_image_features(images=frame).float()
+                for frame in images.split(1)
+            ], dim=0)
+        else:
